+            return why(ev[i] as number);
+          }
+          jnl_map(FL.spun, ev[i + 1] as string, ev[i + 2] as string);
+        }
+        i += 4;
+        break;
+      }
+      case E_SPIN: {
+        jnl_push(FL.spins, ev[i + 1] as Seg);
+        i += 2;
+        break;
+      }
+      case E_SEG: {
+        jnl_push(FL.segs, ev[i + 1] as Seg);
+        i += 2;
+        break;
+      }
+      case E_SEGN: {
+        if (FL.segs.length !== ev[i + 1]) {
+          return why(ev[i] as number);
+        }
+        i += 2;
+        break;
+      }
+      case E_CGET: {
+        const pos = ev[i + 1] as Lay;
+        if (!FL.consts.has(pos)) {
+          jnl_map(FL.consts, pos, new Map());
+        }
+        if (!val_same(FL.consts.get(pos)!.get(ev[i + 2] as HTerm),
+          ev[i + 3] as Val | undefined)) {
+          return why(ev[i] as number);
+        }
+        i += 4;
+        break;
+      }
+      case E_CSET: {
+        jnl_map(FL.consts.get(ev[i + 1] as Lay)!, ev[i + 2] as HTerm,
+          ev[i + 3] as Val);
+        i += 4;
+        break;
+      }
+      case E_LIT: {
+        const cur = FL.lits.get(ev[i + 1] as string);
+        if (ev[i + 3]) {
+          if (cur !== ev[i + 2]) {
+            return why(ev[i] as number);
+          }
+        } else {
+          if (cur !== undefined || FL.img.length !== ev[i + 2]) {
+            return why(ev[i] as number);
+          }
+          jnl_push(FL.img, ...ev[i + 4] as string[]);
+          jnl_map(FL.lits, ev[i + 1] as string, ev[i + 2] as number);
+        }
+        i += 5;
+        break;
+      }
+      case E_TAB: {
+        const cur = FL.tabs.get(ev[i + 1] as string);
+        if (ev[i + 3]) {
+          if (cur !== ev[i + 2]) {
+            return why(ev[i] as number);
+          }
+        } else {
+          if (cur !== undefined || FL.tabs.size !== ev[i + 2]) {
+            return why(ev[i] as number);
+          }
+          jnl_map(FL.tabs, ev[i + 1] as string, ev[i + 2] as number);
+        }
+        i += 4;
+        break;
+      }
+      case E_CLOS: {
+        jnl_set(FL.clos, ev[i + 1] as string);
+        i += 2;
+        break;
+      }
+      case E_LEND: {
+        jnl_set(FL.lend, ev[i + 1] as string);
+        i += 2;
+        break;
+      }
+      default: {
+        die("a bad trace");
+      }
+    }
+  }
+  return true;
+}
