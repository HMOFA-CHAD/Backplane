+        }
+        if (!bool_same(brw_of(k), ev[i + 2] as boolean[])) {
+          return why(ev[i] as number);
+        }
+        i += 3;
+        break;
+      }
+      case E_SPUN: {
+        const cur = FL.spun.get(ev[i + 1] as string);
+        if (ev[i + 3]) {
+          if (cur !== ev[i + 2]) {
+            return why(ev[i] as number);
+          }
+        } else {
