+  return a === b || (a !== undefined && b !== undefined && a.lay === b.lay
+    && a.stat === b.stat && a.ws.length === b.ws.length
+    && a.ws.every((w, i) => w === b.ws[i]));
+}
+
+function bool_same(a: boolean[], b: boolean[]): boolean {
+  return a.length === b.length && a.every((x, i) => x === b[i]);
+}
+
+// Replays a def's trace; false (and nothing changed) if it would differ.
+function rec_replay(r: Rec): boolean {
+  JNL = [];
+  const ok = rec_steps(r);
+  if (!ok) {
+    JNL.reverse().forEach((u) => u());
+  }
+  JNL = null;
+  return ok;
