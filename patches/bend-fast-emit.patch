+// Trace
+// -----
+
+// compile_book's passes are replayed, not re-emitted, where they cannot
+// differ. A def's emission depends on the book's facts only through the
+// facts it reads absent (a present fact stays present), the per-pass tables
+// it reads or fills (lend, clos, brws, spun, consts, lits, tabs, segs,
+// spins, img) and the facts_hot closures it runs, which add hot facts and
+// write nothing else. REC is the def being recorded: its first absent read
+// of each fact, each table step in order, and each facts_hot / facts_ctr
+// call (a bracket) with the hot facts it read absent. A later pass replays
+// a def's trace against the tables in order, checking each read and
+// applying each table write; a bracket whose absent facts are still absent
+// would run the same and add nothing new, else it runs again. If every
+// check holds the def would emit exactly what it emitted last pass, its
+// segments and table entries included; else the replay is undone and the
+// def is emitted afresh, recording a new trace. JNL undoes a replay.
+
+const E_ABS = 1; // set, key: read absent
+const E_BRK = 2; // [def, kind, a, b, c, keys]: a facts closure
+const E_BRW = 3; // k, borrows
+const E_SPUN = 4; // key, name, hit
+const E_SPIN = 5; // seg pushed to spins
+const E_SEG = 6; // seg pushed to segs
+const E_SEGN = 7; // segs.length read
+const E_CGET = 8; // pos, x, val | undefined
+const E_CSET = 9; // pos, x, val
+const E_LIT = 10; // key, at, hit, exprs
+const E_TAB = 11; // key, n, hit
+const E_CLOS = 12; // fid
+const E_LEND = 13; // key
+
+type Brk = [Name, number, unknown, unknown, unknown, string[]];
+
+type Rec = { ev: unknown[]; abs: Set<string>; once: Set<string> };
+
+let REC: Rec | null = null;
+
+// the bracket being recorded: the facts it read absent before adding them
+// (false) or added first (true); adds lists each fact it added, for undo
+let BRK: { seen: Map<string, boolean>; adds: string[] | null } | null = null;
+
+let JNL: (() => void)[] | null = null;
+
+function rec_once(tag: string): boolean {
+  if (REC === null || REC.once.has(tag)) {
+    return false;
+  }
+  REC.once.add(tag);
+  return true;
+}
+
+function fact_has(set: Set<string>, s: string, k: string): boolean {
+  const a = set.has(k);
+  if (!a && REC !== null && BRK === null && !REC.abs.has(s + k)) {
+    REC.abs.add(s + k);
+    REC.ev.push(E_ABS, set, k);
+  }
+  return a;
+}
+
+function hot_has(k: string): boolean {
+  const a = FL.hot.has(k);
+  if (BRK !== null && !BRK.seen.has(k)) {
+    BRK.seen.set(k, a);
+  }
+  return a;
+}
+
+function hot_add(k: string): void {
+  if (FL.hot.has(k)) {
+    return;
+  }
+  FL.hot.add(k);
+  if (BRK !== null) {
+    if (!BRK.seen.has(k)) {
+      BRK.seen.set(k, true);
+    }
+    BRK.adds?.push(k);
+  }
+}
+
+function brk_run(b: Brk, adds: string[] | null): void {
+  const was = BRK;
+  BRK = { seen: new Map(), adds };
+  const sc = { def: b[0] } as Scope;
+  if (b[1] === 0) {
+    facts_hot(sc, b[2] as HTerm | null, b[3] as boolean, b[4] as boolean);
+  } else {
+    facts_ctr(sc, b[2] as Bend.Ctr, b[3] as HTerm[]);
+  }
+  b[5] = [...BRK.seen].flatMap(([k, a]) => a ? [] : [k]);
+  BRK = was;
+}
+
+// facts_hot / facts_ctr as called from the emitter
+function facts_run(sc: Scope, kind: number, a: unknown, b: unknown,
+  c: unknown = false): void {
+  if (REC === null || BRK !== null) {
+    if (kind === 0) {
+      return facts_hot(sc, a as HTerm | null, b as boolean, c as boolean);
+    }
+    return facts_ctr(sc, a as Bend.Ctr, b as HTerm[]);
+  }
+  const brk: Brk = [sc.def, kind, a, b, c, []];
+  brk_run(brk, null);
+  if (brk[5].length > 0) {
+    REC.ev.push(E_BRK, brk);
+  }
+}
+
+function jnl_set<K>(s: Set<K>, k: K): void {
+  if (!s.has(k)) {
+    s.add(k);
+    JNL!.push(() => s.delete(k));
+  }
+}
+
+function jnl_map<K, V>(m: Map<K, V>, k: K, v: V): void {
+  const had = m.has(k);
+  const old = m.get(k);
+  m.set(k, v);
+  JNL!.push(had ? () => m.set(k, old as V) : () => m.delete(k));
+}
+
+function jnl_push<T>(xs: T[], ...ys: T[]): void {
+  const n = xs.length;
+  xs.push(...ys);
+  JNL!.push(() => xs.splice(n));
