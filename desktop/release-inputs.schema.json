{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backplane supplied release artifact inputs",
  "description": "Envelope schema; semantic component/native receipt validation is enforced by the CLI and documented in RELEASE-PRODUCER.md. This schema is not platform evidence.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "target",
        "release",
        "shell",
        "electron",
        "service"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "backplane-electron-release-inputs"
        },
        "target": {
          "enum": [
            "linux-x64",
            "linux-arm64",
            "darwin-arm64",
            "windows-x64"
          ]
        },
        "release": {
          "$ref": "#/$defs/release"
        },
        "shell": {
          "$ref": "#/$defs/component"
        },
        "electron": {
          "$ref": "#/$defs/component"
        },
        "service": {
          "oneOf": [
            {
              "$ref": "#/$defs/component"
            },
            {
              "$ref": "#/$defs/windowsService"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "target",
        "release",
        "web",
        "emissionReceipt"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "backplane-web-release-inputs"
        },
        "target": {
          "const": "web"
        },
        "release": {
          "$ref": "#/$defs/release"
        },
        "web": {
          "$ref": "#/$defs/component"
        },
        "emissionReceipt": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "target",
        "stageReceiptSha256",
        "payloadManifestSha256",
        "signing",
        "sandbox",
        "lifecycle",
        "runtimeAcceptance"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "backplane-desktop-target-acceptance"
        },
        "target": {
          "enum": [
            "linux-x64",
            "linux-arm64",
            "darwin-arm64",
            "windows-x64"
          ]
        },
        "stageReceiptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "payloadManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signing": {
          "$ref": "#/$defs/artifact"
        },
        "sandbox": {
          "$ref": "#/$defs/artifact"
        },
        "lifecycle": {
          "$ref": "#/$defs/artifact"
        },
        "runtimeAcceptance": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "directory"
          ]
        },
        {
          "required": [
            "archive"
          ]
        }
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "archive": {
          "$ref": "#/$defs/artifact"
        },
        "root": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "receipt",
        "payload"
      ],
      "properties": {
        "receipt": {
          "$ref": "#/$defs/artifact"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": [
        "version",
        "tag",
        "channel",
        "commit",
        "tree",
        "freezeReceipt"
      ],
      "properties": {
        "version": {
          "const": "0.12.0"
        },
        "tag": {
          "const": "v0.12.0"
        },
        "channel": {
          "const": "release"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "freezeReceipt": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "windowsService": {
      "type": "object",
      "required": [
        "contractSha256",
        "archive"
      ],
      "properties": {
        "contractSha256": {
          "const": "1c12bd80b6f994ecd0d68d06b8ada98e1958de725d33f6380da3c0243ad099e3"
        },
        "archive": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "residentLifecyclePolicy": {
      "type": "object",
      "required": [
        "mode",
        "managedStop",
        "managedUpdate"
      ],
      "properties": {
        "mode": {
          "const": "resident-service"
        },
        "managedStop": {
          "const": false
        },
        "managedUpdate": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "releaseFreeze": {
      "type": "object",
      "description": "Root-approved freeze artifact referenced by each request; full identity/component/config semantic checks remain enforced by CLI.",
      "required": [
        "schema",
        "kind",
        "status",
        "version",
        "tag",
        "channel",
        "commit",
        "tree",
        "components",
        "sourceDateEpoch",
        "signingPolicy"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "backplane-release-freeze"
        },
        "status": {
          "const": "FROZEN"
        },
        "version": {
          "const": "0.12.0"
        },
        "tag": {
          "const": "v0.12.0"
        },
        "channel": {
          "const": "release"
        },
        "lifecyclePolicy": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "linux-x64",
              "linux-arm64",
              "darwin-arm64",
              "windows-x64"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/residentLifecyclePolicy"
          }
        }
      }
    }
  }
}
