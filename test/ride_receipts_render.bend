def bot() -> U.Ui:
  U.Act.ui(U.Uber.show(base()))

def running() -> U.Ui:
  U.Ui.fold([M.TurnChanged{"bub-chat", M.Running{}, 221n}], bot())

def streamed() -> U.Ui:
  U.Ui.recv(running(), parsed("{\"t\":\"delta\",\"thread\":\"bub-chat\",\"text\":\"Fixture streaming text retained.\"}"))

def new_receipt() -> U.Ui:
  U.Ui.fold([M.ActivityLogged{"bub-chat", "ride:new-after-load", "info", "ride", "Delivered into running turn", 222n}], streamed())

def new_session() -> U.Ui:
  U.Ui.fold([M.ActivityLogged{"bub-chat", "opencode-new-context-reset", "info", "session", "Fixture new OpenCode lost-context notice after load; retain.", 223n}], new_receipt())

def cleared() -> U.Ui:
  U.Ui.fold([M.TurnChanged{"bub-chat", M.Completed{}, 224n}], streamed())

def main() -> IO(Unit):
  IO.print(J.Json.show(J.Json.obj([
    J.KV{"completed", A.presentation_view(bot())},
    J.KV{"direct", A.presentation_view(U.Ui.select.k(base(), "bub-chat"))},
    J.KV{"otherBot", A.presentation_view(U.Ui.select.k(base(), "other-bot-chat"))},
    J.KV{"ordinary", A.presentation_view(U.Ui.select.k(base(), "ordinary"))},
    J.KV{"running", A.presentation_view(running())},
    J.KV{"streamed", A.presentation_view(streamed())},
    J.KV{"newReceipt", A.presentation_view(new_receipt())},
    J.KV{"newSession", A.presentation_view(new_session())},
    J.KV{"cleared", A.presentation_view(cleared())}])) ++ "\n")
