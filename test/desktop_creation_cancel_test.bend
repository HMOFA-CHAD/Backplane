import Base
import ../src/server/desktop-broker.bend as B
import ../src/core/desktop-browser.bend as D
import ../src/core/json.bend as J
import ./desktop_preparation_test.bend as P

def check(name: String, ok: Bool) -> IO(Unit):
  match ok:
    case True{}: IO.print("ok " ++ name)
    case False{}: IO.die(Unit, 1, "FAIL " ++ name)

def failed(+b: B.Broker) -> J.Json:
  J.Json.obj([J.KV{"owner", J.Str{"A"}}, J.KV{"phase", J.Str{"preparation"}}, J.KV{"prepareId", J.Str{J.Json.get_str(B.Broker.preparation(b, "A"), "prepareId", "")}}, J.KV{"createId", J.Str{J.Json.get_str(B.Broker.preparation(b, "A"), "createId", "")}}])

def cancelled(+b: B.Broker, destroyed: Bool) -> J.Json:
  +prep = B.Broker.preparation(b, "A")
  D.Desktop.put(D.Desktop.put(D.Desktop.put(failed(b), "cancelId", J.Str{J.Json.get_str(prep, "cancelId", "")}), "notCreated", J.Flag{True{}}), "receipt", J.Json.obj([J.KV{"owner", J.Str{"A"}}, J.KV{"createId", J.Str{J.Json.get_str(prep, "createId", "")}}, J.KV{"target", J.Null{}}, J.KV{"closed", J.Flag{True{}}}, J.KV{"nativeDestroyed", J.Flag{destroyed}}, J.KV{"alreadyAborted", J.Flag{False{}}}]))

def main() -> IO(Unit):
  do IO<Unit>:
    +out : Chan(String) <- Chan.new(String, 128)
    +reply : Chan(String) <- Chan.new(String, 8)
    +q : Chan(B.Message) <- Chan.new(B.Message, 8)
    +events : Chan(String) <- Chan.new(String, 8)
    +prep : B.Broker <- B.Broker.prepare_start(P.base(out), "navigate", P.args(), reply)
    P.drain(4n, out)
    +original : String = J.Json.get_str(B.Broker.preparation(prep, "A"), "prepareId", "")
    check("failure packet matches only original pending creation", B.Broker.prepare_failed_valid(prep, failed(prep)))
    check("foreign create cannot start cancellation", Bool.not(B.Broker.prepare_failed_valid(prep, D.Desktop.put(failed(prep), "createId", J.Str{"foreign"}))))
    check("wrong phase cannot abort creation", Bool.not(B.Broker.prepare_failed_valid(prep, D.Desktop.put(failed(prep), "phase", J.Str{"dispatch"}))))
    +cancel : B.Broker <- B.Broker.prepare_failed(prep, failed(prep), "failure-event")
    +answer : J.Json <- P.read(reply)
    check("original caller gets known predispatch failure", Bool.and(Bool.not(J.Json.get_bool(answer, "ok", True{})), Bool.not(J.Json.get_bool(answer, "dispatched", True{}))))
    +revocation : J.Json <- P.read(out)
    +packet : J.Json <- P.read(out)
    check("cancellation revokes both capture and mutation", String.eq(J.Json.get_str(J.Json.get_obj(revocation, "payload"), "scope", ""), "all"))
    check("service sends explicit cancellation operation", String.eq(J.Json.get_str(packet, "op", ""), "browser.cancel"))
    check("cancellation has new phase ID", Bool.not(String.eq(J.Json.get_str(packet, "id", ""), original)))
    check("packet retains original exact createId", String.eq(J.Json.get_str(J.Json.get_obj(packet, "payload"), "createId", ""), J.Json.get_str(B.Broker.preparation(prep, "A"), "createId", "-")))
    check("owner remains in cleanup phase", B.Broker.cancelling(cancel, "A"))
    check("cleanup cannot become prepared dispatch", Bool.not(B.Broker.preparation_current(cancel, "A")))
    check("cancellation consumes original preparation pending", Bool.not(B.Broker.pending_id(B.Broker.pending(cancel), original)))
    check("cleanup has no ordinary dispatched owner", String.is_empty(B.Broker.pending_original_owner(B.Broker.pending(cancel), J.Json.get_str(packet, "id", ""))))
    check("cleanup disconnect preserves unresolved owner", J.Json.get_bool(J.Json.get_obj(B.Broker.pending_latches(B.Broker.pending(cancel), B.Broker.meta(cancel)), "unknownOwners"), "A", False{}))
    +staleTimer : B.Broker <- B.Broker.timeout(cancel, original)
    check("old preparation timer cannot settle cancellation", B.Broker.cancelling(staleTimer, "A"))
    check("late failure cannot initiate second abort", Bool.not(B.Broker.prepare_failed_valid(cancel, failed(cancel))))
    +refused : B.Broker <- B.Broker.call(cancel, q, "navigate", P.args(), reply)
    +sameOwner : J.Json <- P.read(reply)
    check("same owner blocked until cleanup evidence", Bool.not(J.Json.get_bool(sameOwner, "ok", True{})))
    check("same owner cannot replace current cleanup", String.eq(J.Json.get_str(B.Broker.preparation(refused, "A"), "cancelId", ""), J.Json.get_str(packet, "id", "-")))
    +proof : J.Json = cancelled(cancel, True{})
    check("exact not-created receipt validates", B.Broker.cancel_receipt_valid(cancel, proof))
    check("foreign cancel ID cannot settle cleanup", Bool.not(B.Broker.cancel_receipt_valid(cancel, D.Desktop.put(proof, "cancelId", J.Str{"foreign"}))))
    check("foreign receipt owner cannot settle cleanup", Bool.not(B.Broker.cancel_receipt_valid(cancel, D.Desktop.put(proof, "receipt", D.Desktop.put(J.Json.get_obj(proof, "receipt"), "owner", J.Str{"B"})))))
    check("missing destruction observation is refused", Bool.not(B.Broker.cancel_receipt_valid(cancel, D.Desktop.put(proof, "receipt", D.Desktop.put(J.Json.get_obj(proof, "receipt"), "nativeDestroyed", J.Str{"true"})))))
    check("registry retirement alone is not destruction", Bool.not(B.Broker.cancel_destroyed(cancelled(cancel, False{}))))
    +uncertain : B.Broker <- B.Broker.cancelled(cancel, cancelled(cancel, False{}), "uncertain-event")
    check("unobserved native destruction latches UNKNOWN", B.Broker.unknown_owner(uncertain, "A"))
    check("uncertain cleanup remains pending", B.Broker.cancelling(uncertain, "A"))
    +lateDestroyed : B.Broker <- B.Broker.cancelled(uncertain, proof, "late-destroyed-event")
    check("later cleanup never clears existing UNKNOWN", B.Broker.unknown_owner(lateDestroyed, "A"))
    +clean : B.Broker <- B.Broker.cancelled(cancel, proof, "clean-event")
    check("verified cleanup clears preparation", Bool.not(B.Broker.preparing(clean, "A")))
    check("verified cleanup consumes cancellation pending", Bool.not(B.Broker.pending_owner(B.Broker.pending(clean), "A")))
    check("known clean undispatched creation does not latch UNKNOWN", Bool.not(B.Broker.unknown_owner(clean, "A")))
    check("completed cancellation cannot be replayed", Bool.not(B.Broker.cancel_receipt_valid(clean, proof)))
    +offered : B.Broker <- B.Broker.frame_op("target.offer", prep, J.Json.obj([J.KV{"id", J.Str{"offer"}}, J.KV{"payload", P.offer(prep, P.target())}]), "A", "version", events)
    +offeredCancel : B.Broker <- B.Broker.prepare_failed(offered, failed(offered), "offered-failed")
    check("offered root snapshot retained for cancellation", D.Target.eq(D.Target.decode(J.Json.get_obj(B.Broker.preparation(offeredCancel, "A"), "target")), D.Target.decode(P.target())))
    check("known root cannot claim no guest was created", Bool.not(B.Broker.cancel_receipt_valid(offeredCancel, cancelled(offeredCancel, True{}))))
    +knownProof : J.Json = D.Desktop.put(cancelled(offeredCancel, True{}), "receipt", D.Desktop.put(J.Json.get_obj(cancelled(offeredCancel, True{}), "receipt"), "target", P.target()))
    check("exact actual known root receipt accepted", B.Broker.cancel_receipt_valid(offeredCancel, knownProof))
    check("other tab cannot impersonate aborted root", Bool.not(B.Broker.cancel_receipt_valid(offeredCancel, D.Desktop.put(knownProof, "receipt", D.Desktop.put(J.Json.get_obj(knownProof, "receipt"), "target", D.Desktop.put(P.target(), "tabId", J.Str{"other"}))))))
    +closeUnknown : J.Json = D.Desktop.put(knownProof, "receipt", D.Desktop.put(J.Json.get_obj(knownProof, "receipt"), "closeUnknown", J.Flag{True{}}))
    check("native close exception cannot become destruction proof", Bool.not(B.Broker.cancel_destroyed(closeUnknown)))
    check("ordinary CDP remains allowed by exact grant", D.Desktop.member(D.Desktop.methods(), "Runtime.evaluate"))
    check("generic file assignment has no method grant", Bool.not(D.Desktop.member(D.Desktop.methods(), "DOM.setFileInputFiles")))
    check("public page disable cannot remove file guard", Bool.not(D.Desktop.member(D.Desktop.methods(), "Page.disable")))
    check("public interception changes have no grant", Bool.not(D.Desktop.member(D.Desktop.methods(), "Page.setInterceptFileChooserDialog")))
    check("public browser reset has no grant", Bool.not(D.Desktop.member(D.Desktop.methods(), "Target.attachToTarget")))
