def bot() -> U.Ui:
  U.Act.ui(U.Uber.show(base()))

def running() -> U.Ui:
  U.Ui.fold([M.TurnChanged{"bub-chat", M.Running{}, 11n}], bot())

def streamed() -> U.Ui:
  U.Ui.recv(running(), parsed("{\"t\":\"delta\",\"thread\":\"bub-chat\",\"text\":\"Fixture streaming text retained.\"}"))

def cleared() -> U.Ui:
  U.Ui.fold([M.TurnChanged{"bub-chat", M.Completed{}, 12n}], streamed())

def main() -> IO(Unit):
  IO.print(J.Json.show(J.Json.obj([
    J.KV{"completed", A.presentation_view(bot())},
    J.KV{"direct", A.presentation_view(U.Ui.select.k(base(), "bub-chat"))},
    J.KV{"otherBot", A.presentation_view(U.Ui.select.k(base(), "other-bot-chat"))},
    J.KV{"ordinary", A.presentation_view(U.Ui.select.k(base(), "ordinary"))},
    J.KV{"running", A.presentation_view(running())},
    J.KV{"streamed", A.presentation_view(streamed())},
    J.KV{"cleared", A.presentation_view(cleared())}])) ++ "\n")
